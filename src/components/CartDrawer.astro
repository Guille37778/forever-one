</style>

<script>
    import { loadCart, cartTotal } from '../lib/cart';

    (function() {
        const el = (id: string) => document.getElementById(id);

        // UI SPECIFIC LOGIC (Rendering)
        (window as any).__renderCart = function() {
            const list = el('products-list');
            const totalUSD = el('cart-total-usd');
            const totalBS = el('cart-total-bs');
            const badge = el('cart-count-badge');
            const label = el('cart-count-label');

            const cart = (window as any).__getCart?.() || [];
            const drawer = el('cart-drawer');
            const dollarRate = parseFloat(drawer?.dataset.rate || '0');

            const total = cartTotal();
            const count = cart.reduce((s: number, i: any) => s + i.qty, 0);

            if(badge) { badge.textContent = count.toString(); badge.style.display = count > 0 ? 'flex' : 'none'; }
            if(label) label.textContent = count + (count === 1 ? ' prenda' : ' prendas');
            if(totalUSD) totalUSD.textContent = '$' + total.toFixed(2);
            if(totalBS) totalBS.textContent = 'Bs. ' + (total * dollarRate + 50 * count).toLocaleString('es-VE', { minimumFractionDigits: 2 });

            // Si está seleccionado Zelle, actualizar también el cuadro Zelle
            if (_selectedPaymentMethod === 'zelle') {
                const drawer = el('cart-drawer');
                const zelleRateVal = parseFloat(drawer?.dataset.zelleRate || '780');
                const totalBs = total * dollarRate + 50 * count;
                const zelleUSD = zelleRateVal > 0 ? totalBs / zelleRateVal : total;
                const zelleUSDEl = el('cart-zelle-total-usd');
                if (zelleUSDEl) zelleUSDEl.textContent = '$' + zelleUSD.toFixed(2);
                const zelleRateDisplayEl = el('cart-zelle-rate-display');
                if (zelleRateDisplayEl) zelleRateDisplayEl.textContent = zelleRateVal.toFixed(2);
            }

            const hasItems = cart.length > 0;
            const form = el('checkout-form-container');
            const empty = el('cart-empty-msg');
            if(empty) empty.style.display = hasItems ? 'none' : 'flex';
            if(form) form.style.display = hasItems ? 'grid' : 'none';

            const checkoutBtn = el('checkout-btn') as HTMLButtonElement;
            if(checkoutBtn) {
                checkoutBtn.style.opacity = hasItems ? '1' : '0.4';
                checkoutBtn.style.pointerEvents = hasItems ? 'auto' : 'none';
                checkoutBtn.style.cursor = hasItems ? 'pointer' : 'not-allowed';
            }

            if(list) {
                // Group cart items by product ID
                const groupedCart: any[] = [];
                cart.forEach((item: any) => {
                    let existingGroup = groupedCart.find((g: any) => g.id === item.id);
                    if (!existingGroup) {
                        existingGroup = {
                            id: item.id,
                            nombre: item.nombre || item.name,
                            image_url: item.image_url || (item.imagenes && item.imagenes[0]) || '/placeholder.png',
                            variants: []
                        };
                        groupedCart.push(existingGroup);
                    }
                    existingGroup.variants.push({
                        size: item.size || '',
                        color: item.color || '',
                        qty: item.qty,
                        precio: item.precio || item.price || 0
                    });
                });

                list.innerHTML = groupedCart.map((item: any) => `
                    <div class="cart-item-card">
                        <img src="${item.image_url}" style="width:64px; height:84px; object-fit:cover; flex-shrink:0; border:1px solid #f0f0f0;" onerror="this.src='/placeholder.png'">
                        <div style="flex:1; min-width:0; overflow:hidden;">
                            <!-- Header: Product name & Delete all button -->
                            <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:6px;">
                                <div style="flex:1; min-width:0; font-size:9px; text-transform:uppercase; letter-spacing:0.2em; font-weight:900; color:#111; margin-bottom:4px; word-break:break-word; line-height:1.4;">
                                    ${item.nombre}
                                </div>
                                <button onclick="window.__removeAllOfProduct('${item.id}')" style="color:#ccc; font-size:18px; border:none; background:none; cursor:pointer; flex-shrink:0; line-height:1; padding:0; margin-left:4px;" title="Eliminar todo">×</button>
                            </div>
                            
                            <!-- Variants List inside this product -->
                            <div style="display:flex; flex-direction:column; gap:10px; margin-top:6px;">
                                ${item.variants.map((v: any) => `
                                    <div style="display:flex; flex-direction:column; gap:4px; padding-bottom:8px; border-bottom:1px dashed #eee;">
                                        <div style="display:flex; gap:4px; flex-wrap:wrap; margin-top:2px;">
                                            ${v.size ? `<span style="font-size:8px; color:#B8860B; text-transform:uppercase; letter-spacing:0.15em; font-weight:700; background:rgba(184,134,11,0.08); padding:2px 6px; display:inline-block;">Talla: ${v.size}</span>` : ''}
                                            ${v.color ? `<span style="font-size:8px; color:#555; text-transform:uppercase; letter-spacing:0.15em; font-weight:700; background:rgba(0,0,0,0.05); padding:2px 6px; display:inline-block;">Color: ${v.color}</span>` : ''}
                                        </div>
                                        <div style="display:flex; align-items:center; justify-content:space-between; margin-top:6px; gap:6px;">
                                            <div style="display:flex; align-items:center; border:1px solid #eee; flex-shrink:0;">
                                                <button onclick="window.__updateQty('${item.id}', -1, '${v.size || ''}', '${v.color || ''}')" style="width:24px; height:24px; border:none; background:#fafafa; cursor:pointer; color:#111; font-weight:bold;">−</button>
                                                <span style="font-size:10px; font-weight:900; min-width:20px; text-align:center; color:#111;">${v.qty}</span>
                                                <button onclick="window.__updateQty('${item.id}', 1, '${v.size || ''}', '${v.color || ''}')" style="width:24px; height:24px; border:none; background:#fafafa; cursor:pointer; color:#111; font-weight:bold;">+</button>
                                            </div>
                                            <div style="text-align:right; display:flex; flex-direction:column; align-items:flex-end; gap:2px; flex-shrink:0; min-width:0;">
                                                <div style="font-family:'Playfair Display',serif; font-size:0.85rem; font-weight:900; font-style:italic; color:#111; line-height:1; white-space:nowrap;">$${(v.precio * v.qty).toFixed(2)}</div>
                                                <div style="font-size:7px; color:#B8860B; font-weight:700; line-height:1; white-space:nowrap;">Bs. ${(v.precio * v.qty * dollarRate + 50 * v.qty).toLocaleString('es-VE',{minimumFractionDigits:2,maximumFractionDigits:2})}</div>
                                            </div>
                                        </div>
                                    </div>
                                `).join('')}
                            </div>
                        </div>
                    </div>
                `).join('');
            }
        };

        (window as any).__openCart = function() {
            const d = el('cart-drawer');
            if(!d) return;
            d.style.display = 'block';
            document.body.style.overflow = 'hidden';
            d.scrollTo(0,0);
            requestAnimationFrame(() => d.style.opacity = '1');
        };

        (window as any).__closeCart = function() {
            const d = el('cart-drawer');
            if(!d) return;
            d.style.opacity = '0';
            document.body.style.overflow = '';
            setTimeout(() => d.style.display = 'none', 400);
        };

        (window as any).__updateDeliveryUI = function() {
            const { selectedMethod, selectedCourier } = (window as any).__getDeliveryData?.() || { selectedMethod: 'retiro', selectedCourier: 'Zoom' };
            
            document.querySelectorAll('.meth-card').forEach((b: any) => {
                if (b.id && b.id.startsWith('btn-meth-')) {
                    b.classList.toggle('active-meth', b.id === 'btn-meth-' + selectedMethod);
                }
            });
            const env = el('envio-fields'); if(env) env.style.display = selectedMethod === 'envio' ? 'flex' : 'none';
            const del = el('delivery-local-fields'); if(del) del.style.display = selectedMethod === 'delivery' ? 'flex' : 'none';
            const ret = el('retiro-fields'); if(ret) ret.style.display = selectedMethod === 'retiro' ? 'block' : 'none';
            document.querySelectorAll('.cour-btn-card').forEach(b => b.classList.toggle('active-cour', b.id === 'btn-courier-' + selectedCourier.toLowerCase()));
            
            const zones = (el('cart-drawer')?.dataset.zones || '').split(',').filter(z => z);
            const zoneSelect = el('delivery-zone-select') as HTMLSelectElement;
            if(zoneSelect && zoneSelect.options.length <= 1 && zones.length > 0) {
                zones.forEach(z => { const opt = document.createElement('option'); opt.value = z; opt.textContent = z; zoneSelect.appendChild(opt); });
            }
        };

        // Payment method state
        let _selectedPaymentMethod = 'pagoMovil';

        (window as any).__setPaymentMethod = function(method: string) {
            _selectedPaymentMethod = method;
            // Update active card — only pay buttons
            ['pagoMovil','zelle','binance'].forEach(m => {
                const btn = el('btn-pay-' + m);
                if(btn) btn.classList.toggle('active-meth', m === method);
            });
            // Show/hide panels
            const panels = ['pagoMovil','zelle','binance'];
            panels.forEach(m => {
                const panel = el('pay-fields-' + m);
                if(panel) panel.style.display = m === method ? 'flex' : 'none';
            });
            // Zelle: mostrar total en USD Zelle + tachado en totales + modal
            const zelleTotalBox = el('cart-zelle-total-box');
            const totalUSDEl   = el('cart-total-usd');
            const totalBSEl    = el('cart-total-bs');
            if (method === 'zelle') {
                const drawer = el('cart-drawer');
                const zelleRateVal = parseFloat(drawer?.dataset.zelleRate || '780');
                const totalUSD = cartTotal();
                const cartItems = (window as any).__getCart?.() || [];
                const totalCount = cartItems.reduce((s: number, i: any) => s + i.qty, 0);
                const zelleUSD = zelleRateVal > 0 ? (totalUSD * dollarRateFromDrawer() + 50 * totalCount) / zelleRateVal : totalUSD;
                // Actualizar caja Zelle
                const zelleUSDEl = el('cart-zelle-total-usd');
                if (zelleUSDEl) zelleUSDEl.textContent = '$' + zelleUSD.toFixed(2);
                const zelleRateDisplayEl = el('cart-zelle-rate-display');
                if (zelleRateDisplayEl) zelleRateDisplayEl.textContent = zelleRateVal.toFixed(2);
                if (zelleTotalBox) zelleTotalBox.style.display = 'block';
                // Tachar Total USD y Bs.
                if (totalUSDEl) totalUSDEl.style.textDecoration = 'line-through';
                if (totalBSEl)  totalBSEl.style.textDecoration  = 'line-through';
                // Mostrar modal
                if (typeof (window as any).showZelleModal === 'function') {
                    (window as any).showZelleModal('$' + zelleUSD.toFixed(2));
                }
            } else {
                if (zelleTotalBox) zelleTotalBox.style.display = 'none';
                // Quitar tachado
                if (totalUSDEl) totalUSDEl.style.textDecoration = 'none';
                if (totalBSEl)  totalBSEl.style.textDecoration  = 'none';
            }
        };

        (window as any).__getPaymentMethod = function() { return _selectedPaymentMethod; };

        // Helper: obtiene la tasa BCV desde el drawer
        function dollarRateFromDrawer(): number {
            return parseFloat(el('cart-drawer')?.dataset.rate || '0');
        }

        (window as any).__checkout = async function() {
            const cart = (window as any).__getCart?.() || [];
            if(cart.length === 0) return;
            const btn = el('checkout-btn') as HTMLButtonElement;
            
            // Normaliza número venezolano → +58XXXXXXXXX
            const normalizePhone = (raw: string): string => {
                let p = raw.replace(/[\s\-\.()]/g, ''); // quitar espacios, guiones, puntos
                if (p.startsWith('+58')) return p;       // ya está bien
                if (p.startsWith('58'))  return '+' + p; // falta el +
                if (p.startsWith('0'))   return '+58' + p.slice(1); // 0412... → +58412...
                return '+58' + p;                        // caso genérico
            };

            const payMethod = (window as any).__getPaymentMethod?.() || 'pagoMovil';

            const vals = {
                name: (el('cust-name') as HTMLInputElement).value.trim(),
                id: (el('cust-id') as HTMLInputElement).value.trim(),
                phone: normalizePhone((el('cust-phone') as HTMLInputElement).value.trim()),
                email: (el('cust-email') as HTMLInputElement).value.trim(),
                payRef: payMethod === 'pagoMovil' ? (el('pay-reference') as HTMLInputElement)?.value.trim() : ''
            };

            // Get the appropriate capture file based on payment method
            const captureInputId = payMethod === 'pagoMovil' ? 'pay-capture' : payMethod === 'binance' ? 'pay-capture-binance' : 'pay-capture-zelle';
            const payCaptureInput = el(captureInputId) as HTMLInputElement;
            const payCaptureFile = payCaptureInput?.files?.[0];

            if(!vals.name || !vals.id || !vals.phone || !vals.email) {
                alert('❌ POR FAVOR, COMPLETE TODOS LOS DATOS PERSONALES');
                return;
            }
            if(payMethod === 'pagoMovil' && !vals.payRef) {
                alert('❌ POR FAVOR, INGRESE EL NÚMERO DE REFERENCIA DEL PAGO MÓVIL');
                return;
            }
            if(!payCaptureFile) {
                alert('❌ POR FAVOR, ADJUNTE EL CAPTURE DE PAGO');
                return;
            }

            // Convertir el archivo a Base64
            const fileToBase64 = (file: File): Promise<string> => new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.readAsDataURL(file);
                reader.onload = () => resolve(reader.result as string);
                reader.onerror = error => reject(error);
            });

            const { selectedMethod, selectedCourier } = (window as any). __getDeliveryData?.() || {};
            const shipAgency = (el('ship-agency-code') as HTMLInputElement)?.value.trim();
            const shipAddr = (el('ship-address') as HTMLTextAreaElement)?.value.trim();
            const delAddr = (el('delivery-address') as HTMLTextAreaElement)?.value.trim();
            const delZone = (el('delivery-zone-select') as HTMLSelectElement)?.value;

            btn.disabled = true; 
            btn.textContent = '⏱ PROCESANDO...';

            // Detectar móvil ANTES de cualquier window.open para no desperdiciar el gesto del usuario
            const isMobile = /Android|iPhone|iPad|iPod|Opera Mini|IEMobile|WPDesktop/i.test(navigator.userAgent);

            // En desktop: abrir ventana vacía ahora (dentro del gesto) y asignarle la URL después
            // En móvil: NO abrir nada ahora; usaremos window.location.href al final
            const waWindow = isMobile ? null : window.open('', '_blank');

            let orderCode = 'PENDIENTE';
            try {
                const payCaptureBase64 = await fileToBase64(payCaptureFile);
                const total = cartTotal();
                const res = await fetch('/api/orders', { 
                    method: 'POST', 
                    headers: { 'Content-Type': 'application/json' }, 
                    body: JSON.stringify({ 
                        items: cart, 
                        total, 
                        customer: { ...vals, payCaptureBase64, payCaptureName: payCaptureFile.name, payMethod },
                        delivery: {
                            method: selectedMethod,
                            courier: selectedCourier,
                            agency: shipAgency,
                            shipAddress: shipAddr,
                            delAddress: delAddr,
                            delZone: delZone
                        }
                    })
                });
                if(res.ok) {
                    const data = await res.json();
                    orderCode = data.orderCode || 'REGISTRADA';
                } else {
                    const errData = await res.json().catch(() => ({}));
                    console.error('Error al registrar pedido:', res.status, errData);
                }
            } catch(e) {
                console.error('Error de red al enviar pedido:', e);
            }
            const drawer = el('cart-drawer');
            const dollarRate = parseFloat(drawer?.dataset.rate || '0');
            const totalUSD = cartTotal();
            const totalBS = totalUSD * dollarRate + 50 * cart.reduce((s: number, i: any) => s + i.qty, 0);
            const now = new Date();
            const dateStr = now.toLocaleDateString('es-VE') + ' ' + now.toLocaleTimeString('es-VE', { hour: '2-digit', minute: '2-digit' });

            let deliverySummary = '';
            if (selectedMethod === 'retiro') {
                deliverySummary = '• MÉTODO: Retiro en Tienda';
            } else if (selectedMethod === 'envio') {
                deliverySummary = `• MÉTODO: Envío Nacional\n• COURIER: ${selectedCourier}\n• AGENCIA: ${shipAgency}\n• DESTINO: ${shipAddr}`;
            } else if (selectedMethod === 'delivery') {
                deliverySummary = `• MÉTODO: Delivery Local\n• ZONA: ${delZone}\n• DIRECCIÓN: ${delAddr}`;
            }

            const itemsSummary = cart.map((i: any) => {
                let variantDesc = '';
                if (i.size && i.color) variantDesc = ` (${i.size} - ${i.color})`;
                else if (i.size) variantDesc = ` (${i.size})`;
                else if (i.color) variantDesc = ` (${i.color})`;
                return `  - ${i.qty}x ${i.nombre}${variantDesc}: $${(i.precio * i.qty).toFixed(2)}`;
            }).join('\n');

            const payMethodLabel: Record<string,string> = { pagoMovil: 'Pago Móvil', zelle: 'Zelle', binance: 'Binance Pay (USDT)' };
            let paymentSummary = `• Método: ${payMethodLabel[payMethod] || payMethod}`;
            if(payMethod === 'pagoMovil') paymentSummary += `\n• Referencia: ${vals.payRef}`;
            else if(payMethod === 'zelle') {
                const drawer = el('cart-drawer');
                const zelleRateVal = parseFloat(drawer?.dataset.zelleRate || '780');
                const totalBs = totalUSD * dollarRate + 50 * cart.reduce((s: number, i: any) => s + i.qty, 0);
                const zelleUSD = zelleRateVal > 0 ? totalBs / zelleRateVal : totalUSD;
                paymentSummary += `\n• Teléfono Zelle: 9044458718`;
                paymentSummary += `\n• Titular Zelle: Eduiglis palacios`;
                paymentSummary += `\n• *MONTO A ENVIAR (ZELLE):* $${zelleUSD.toFixed(2)} USD`;
                paymentSummary += `\n• Tasa Zelle aplicada: Bs. ${zelleRateVal.toFixed(2)} / $1`;
            }
            else if(payMethod === 'binance') paymentSummary += `\n• ID Binance Pay: 123456789\n• Moneda: USDT (TRC20 / BEP20)`;

            const msg = `✦ *RESUMEN DE COMPRA — FOREVER ONE* ✦
----------------------------------
📦 *ORDEN:* #${orderCode}
📅 *FECHA:* ${dateStr}

👤 *CLIENTE:*
• Nombre: ${vals.name}
• Cédula: ${vals.id}
• Teléfono: ${vals.phone}

🛍️ *PEDIDO:*
${itemsSummary}

🚚 *ENTREGA:*
${deliverySummary}

💰 *PAGO:*
${paymentSummary}
• *TOTAL USD:* $${totalUSD.toFixed(2)}
• *TOTAL Bs:* ${totalBS.toLocaleString('es-VE', { minimumFractionDigits: 2 })} (Tasa: ${dollarRate})
----------------------------------
_Confirmando mi pedido en el Atelier..._`;

            const waUrl = `https://wa.me/584244557693?text=${encodeURIComponent(msg)}`;

            if (isMobile) {
                // En móvil: redirigir directamente → Android/iOS abren la app de WhatsApp
                window.location.href = waUrl;
            } else {
                // En escritorio: navegar la ventana ya abierta (evita bloqueador de popups)
                if (waWindow) {
                    waWindow.location.href = waUrl;
                } else {
                    window.open(waUrl, '_blank');
                }
            }
            
            localStorage.removeItem('fo1_cart'); 
            setTimeout(() => window.location.reload(), 1000);
        };

        // CAPTURE UPLOAD PREVIEW — inicializa listeners para los 3 métodos de pago
        function initCapturePreview() {
            const configs = [
                { inputId: 'pay-capture',          dropId: 'capture-drop-zone',          emptyId: 'capture-empty-state',          successId: 'capture-success-state',          previewId: 'capture-preview',          filenameId: 'capture-filename' },
                { inputId: 'pay-capture-zelle',    dropId: 'capture-drop-zone-zelle',    emptyId: 'capture-empty-state-zelle',    successId: 'capture-success-state-zelle',    previewId: 'capture-preview-zelle',    filenameId: 'capture-filename-zelle' },
                { inputId: 'pay-capture-binance',  dropId: 'capture-drop-zone-binance',  emptyId: 'capture-empty-state-binance',  successId: 'capture-success-state-binance',  previewId: 'capture-preview-binance',  filenameId: 'capture-filename-binance' },
            ];

            configs.forEach(cfg => {
                const captureInput = document.getElementById(cfg.inputId) as HTMLInputElement;
                if (!captureInput || captureInput.dataset.listenerAttached === 'true') return;
                captureInput.dataset.listenerAttached = 'true';

                captureInput.addEventListener('change', () => {
                    const file = captureInput.files?.[0];
                    if (!file) return;
                    const dropZone     = document.getElementById(cfg.dropId);
                    const emptyState   = document.getElementById(cfg.emptyId);
                    const successState = document.getElementById(cfg.successId);
                    const previewImg   = document.getElementById(cfg.previewId) as HTMLImageElement;
                    const filenameSpan = document.getElementById(cfg.filenameId);

                    const reader = new FileReader();
                    reader.onload = (e) => {
                        const result = e.target?.result as string;
                        if (previewImg)   { previewImg.src = result; }
                        if (filenameSpan) { filenameSpan.textContent = file.name; }
                        if (emptyState)   { emptyState.style.display = 'none'; }
                        if (successState) { successState.style.display = 'flex'; }
                        if (dropZone)     { dropZone.classList.add('has-file'); }
                    };
                    reader.onerror = () => {
                        if (filenameSpan) { filenameSpan.textContent = file.name; }
                        if (emptyState)   { emptyState.style.display = 'none'; }
                        if (successState) { successState.style.display = 'flex'; }
                        if (dropZone)     { dropZone.classList.add('has-file'); }
                    };
                    reader.readAsDataURL(file);
                });
            });
        }

        // INITIALIZE
        loadCart();
        (window as any).__renderCart();
        initCapturePreview();
        
        document.addEventListener('astro:after-swap', () => {
            loadCart();
            (window as any).__renderCart();
            initCapturePreview();
        });
    })();
</script>
