    .cart-section-num { width: 24px; height: 24px; background: #0a0a0a; color: #f3cf7a; font-size: 11px; font-weight: 900; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .cart-input { width: 100%; padding: 0.875rem 1rem; border: 1px solid rgba(0,0,0,0.1); font-size: 12px; font-family: inherit; outline: none; transition: border-color 0.3s, box-shadow 0.3s; box-sizing: border-box; background: #fff; color: #111; }
    .cart-input:focus { border-color: #B8860B; box-shadow: 0 0 0 3px rgba(184,134,11,0.08); }
    .cart-input::placeholder { color: #aaa; font-size: 11px; font-style: italic; }
    .cart-field-label { font-size: 9px; text-transform: uppercase; letter-spacing: 0.3em; font-weight: 700; color: #999; margin-bottom: 0.5rem; }
    .meth-card { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 1.25rem 0.75rem; border: 1.5px solid rgba(0,0,0,0.1); background: #fff; cursor: pointer; transition: all 0.25s; gap: 2px; font-size: 9px; text-transform: uppercase; letter-spacing: 0.3em; font-weight: 900; color: #555; }
    .meth-card small { font-size: 8px; font-weight: 400; color: #aaa; text-transform: uppercase; letter-spacing: 0.2em; }
    .meth-card:hover { border-color: #B8860B; color: #B8860B; }
    .meth-card.active-meth { background: #0a0a0a; border-color: #0a0a0a; color: #f3cf7a; }
    .cour-btn-card { padding: 0.875rem; border: 1px solid rgba(0,0,0,0.1); background: #fff; cursor: pointer; font-size: 10px; text-transform: uppercase; letter-spacing: 0.25em; color: #555; transition: all 0.2s; width: 100%; }
    .cour-btn-card:hover { border-color: #B8860B; color: #B8860B; }
    .cour-btn-card.active-cour { background: #0a0a0a; color: #f3cf7a; border-color: #0a0a0a; }
    .cart-item-card { display: flex; gap: 12px; padding: 1rem; background: #fff; border: 1px solid rgba(0,0,0,0.07); width: 100%; box-sizing: border-box; overflow: hidden; min-width: 0; }
    .cart-input-grid { display: grid; grid-template-columns: 1fr; gap: 0.875rem; }
    @media (min-width: 640px) { .cart-input-grid { grid-template-columns: 1fr 1fr; } }
    .method-grid, .courier-grid { display: grid; grid-template-columns: 1fr; gap: 0.75rem; margin-bottom: 1.5rem; }
    @media (min-width: 480px) { .method-grid, .courier-grid { grid-template-columns: 1fr 1fr 1fr; } }

    /* ── CAPTURE UPLOAD ZONE ────────────────────────── */
    .capture-drop-zone {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 100%;
        max-width: 100%;
        min-height: 130px;
        border: 2px dashed rgba(184,134,11,0.35);
        background: rgba(184,134,11,0.03);
        cursor: pointer;
        transition: all 0.3s ease;
        padding: 1.5rem;
        box-sizing: border-box;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    .capture-drop-zone:hover {
        border-color: #B8860B;
        background: rgba(184,134,11,0.07);
    }
    .capture-drop-zone--blue:hover { border-color: #0070ba; background: rgba(0,112,186,0.07); }
    .capture-drop-zone--purple:hover { border-color: #6e3cb4; background: rgba(110,60,180,0.07); }
    .capture-drop-zone--binance { border-color: rgba(243,186,47,0.35); background: rgba(243,186,47,0.03); }
    .capture-drop-zone--binance:hover { border-color: #F3BA2F; background: rgba(243,186,47,0.07); }
    .capture-drop-zone.has-file {
        border-style: solid;
        border-color: rgba(34,197,94,0.5);
        background: rgba(34,197,94,0.03);
        padding: 1rem;
        min-height: auto;
        align-items: stretch;
        overflow: hidden;
        max-width: 100%;
    }
    @keyframes popIn {
        from { transform: scale(0); opacity: 0; }
        to   { transform: scale(1); opacity: 1; }
    }

    /* ── CART FAB RESPONSIVE ────────────────────────── */
    .cart-fab {
        position: fixed !important;
        bottom: 24px !important;
        right: 24px !important;
        z-index: 1500 !important;
        width: 64px;
        height: 64px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255,255,255,0.2);
        background: linear-gradient(135deg,#8B6508 0%,#B8860B 25%,#f3cf7a 50%,#B8860B 75%,#8B6508 100%);
        background-size: 200% auto;
        animation: shine 5s linear infinite;
        box-shadow: 0 8px 32px rgba(184,134,11,0.4);
        cursor: pointer;
        transition: transform 0.2s ease;
    }
