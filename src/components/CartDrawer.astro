<script>
    function showZelleModal(amount: string) {
        const overlay = document.getElementById('zelle-modal-overlay');
        const amountEl = document.getElementById('zelle-modal-amount');
        if (!overlay) return;
        if (amountEl) amountEl.textContent = amount;
        overlay.style.display = 'flex';
        requestAnimationFrame(() => { overlay.style.opacity = '1'; });
    }
    function closeZelleModal() {
        const overlay = document.getElementById('zelle-modal-overlay');
        if (!overlay) return;
        overlay.style.opacity = '0';
        setTimeout(() => { overlay.style.display = 'none'; }, 350);
    }

    function showCopyToast(msg: string) {
        const t = document.createElement('div');
        t.innerHTML = `<div style="display:flex; align-items:center; gap:8px;">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>${msg}</span>
        </div>`;
        t.style.cssText = 'position:fixed; top:50%; left:50%; transform:translate(-50%, -50%) scale(0.85); opacity:0; background:rgba(20,20,20,0.95); color:#B8860B; padding:16px 32px; border-radius:16px; font-weight:700; font-size:12px; letter-spacing:0.2em; text-transform:uppercase; z-index:999999; backdrop-filter:blur(8px); box-shadow:0 12px 40px rgba(0,0,0,0.4), 0 0 0 1px rgba(184,134,11,0.3); transition:all 0.3s cubic-bezier(0.34,1.56,0.64,1); pointer-events:none; font-family:"Inter",sans-serif; text-align:center;';
        document.body.appendChild(t);
        requestAnimationFrame(() => {
            t.style.transform = 'translate(-50%, -50%) scale(1)';
            t.style.opacity = '1';
        });
        setTimeout(() => {
            t.style.transform = 'translate(-50%, -50%) scale(0.85)';
            t.style.opacity = '0';
            setTimeout(() => t.remove(), 350);
        }, 2200);
    }

    // Exponer globalmente para que el script del carrito las use
    (window as any).showZelleModal  = showZelleModal;
    (window as any).closeZelleModal = closeZelleModal;
    (window as any).showCopyToast   = showCopyToast;
</script>

