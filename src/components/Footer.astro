---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="relative bg-black pt-20 pb-10 border-t border-white/5 overflow-hidden w-full">
    
    <div class="max-w-7xl mx-auto px-6 relative z-10">
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-16 mb-20 text-center lg:text-left">
            
            <div>
                <a href={`${base}`} class="inline-block mb-6">
                    <div class="flex flex-col justify-center text-left">
                        <span class="text-2xl md:text-3xl font-serif font-black italic tracking-tighter text-white leading-none pr-2">
