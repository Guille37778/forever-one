---
import { ClientRouter } from 'astro:transitions';
import CartDrawer from '../components/CartDrawer.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Forever One | Luxury Experience - High-End Fashion House" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href={`${base}/logo_circular.png`} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
		<!-- Google Fonts -->
		<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700;900&family=Inter:wght@300;400;700&family=Montserrat:wght@300;400;700;900&display=swap" rel="stylesheet">
		
		<style>
			/* ── FORZAR VISIBILIDAD TOTAL ─────────────────────── */
			[data-aos] {
				opacity: 1 !important;
				visibility: visible !important;
				transform: none !important;
			}

			/* ── ZOOM 80% EN PC ────────────────────────────────── */
			/* Hace que el sitio se vea igual que al 80% de zoom
			   del navegador, sin que el usuario tenga que ajustarlo */
			@media (min-width: 1024px) {
				html {
					zoom: 0.8;
				}
			}
		</style>
		
		<ClientRouter />
	</head>
	<body class="bg-black text-white font-sans antialiased uppercase tracking-widest"
		x-data="{ mobileMenuOpen: false, atTop: true }"
		:class="{ 'overflow-hidden': mobileMenuOpen }"
		@scroll.window="atTop = (window.pageYOffset > 50 ? false : true)">

		<slot />
		<CartDrawer />

		<!-- WhatsApp Floating Button -->
		<a
			href="https://wa.me/584244557693"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Contáctanos por WhatsApp"
			class="whatsapp-float"
		>
			<span class="whatsapp-tooltip">¡Chatea con nosotros!</span>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
				<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
			</svg>
		</a>
		
		<script>
			declare global {
				interface Window {
					Alpine: any;
					__addToCart: (product: any) => void;
					__initGalleryCycle: () => void;
				}
			}

			let galleryIntervals: any[] = [];

			(window as any).__initGalleryCycle = function() {
				// Clear any existing intervals
				galleryIntervals.forEach(interval => clearInterval(interval));
				galleryIntervals = [];

				const containers = document.querySelectorAll('.product-card-image-container');
				containers.forEach(container => {
					const images = container.querySelectorAll('img');
					if (images.length <= 1) return;

					let currentIndex = 0;
					const intervalId = setInterval(() => {
						// Remove active class from current image
						images[currentIndex].classList.remove('active');
						
						// Go to next image
						currentIndex = (currentIndex + 1) % images.length;
						
						// Add active class to new image
						images[currentIndex].classList.add('active');
					}, 3000); // cycle every 3 seconds

					galleryIntervals.push(intervalId);
				});
			};

			// Run on load and after transitions
			document.addEventListener('DOMContentLoaded', () => (window as any).__initGalleryCycle());
			document.addEventListener('astro:after-swap', () => (window as any).__initGalleryCycle());
		</script>
	</body>
</html>

<style is:global>
	[x-cloak] { display: none !important; }

	/* ── WhatsApp Floating Button ──────────────────────── */
	.whatsapp-float {
		position: fixed;
		bottom: 2rem;
		left: 2rem;
		right: auto;
		z-index: 9999;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 60px;
		height: 60px;
		border-radius: 50%;
		background-color: #25D366;
		color: #fff;
		box-shadow: 0 4px 20px rgba(37, 211, 102, 0.45);
		transition: transform 0.3s ease, box-shadow 0.3s ease;
		text-decoration: none;
		animation: wa-pulse 2.5s ease-in-out infinite;
	}

	.whatsapp-float svg {
		width: 32px;
		height: 32px;
		flex-shrink: 0;
	}

	.whatsapp-float:hover {
		transform: scale(1.12);
		box-shadow: 0 6px 28px rgba(37, 211, 102, 0.65);
		animation: none;
	}

	/* Tooltip sale hacia la DERECHA porque el botón está a la izquierda */
	.whatsapp-tooltip {
		position: absolute;
		left: 72px;
		right: auto;
		white-space: nowrap;
		background: #fff;
		color: #111;
		font-size: 0.78rem;
		font-family: 'Inter', sans-serif;
		font-weight: 600;
		letter-spacing: 0.02em;
		text-transform: none;
		padding: 0.4rem 0.85rem;
		border-radius: 999px;
		box-shadow: 0 2px 12px rgba(0,0,0,0.18);
		opacity: 0;
		transform: translateX(-8px);
		transition: opacity 0.25s ease, transform 0.25s ease;
		pointer-events: none;
	}

	.whatsapp-float:hover .whatsapp-tooltip {
		opacity: 1;
		transform: translateX(0);
	}

	@keyframes wa-pulse {
		0%, 100% { box-shadow: 0 4px 20px rgba(37, 211, 102, 0.45); }
		50% { box-shadow: 0 4px 32px rgba(37, 211, 102, 0.8), 0 0 0 10px rgba(37, 211, 102, 0.12); }
	}

	/* ── Móvil: más pequeño y sin tooltip para evitar overflow ── */
	@media (max-width: 640px) {
		.whatsapp-float {
			width: 50px;
			height: 50px;
			bottom: 1rem;
			left: 1rem;
		}
		.whatsapp-float svg {
			width: 26px;
			height: 26px;
		}
		.whatsapp-tooltip {
			display: none;
		}
	}
</style>
