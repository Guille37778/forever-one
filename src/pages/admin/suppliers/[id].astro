<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    
    // --- Tabs Logic ---
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabPanels = document.querySelectorAll('.tab-panel');
    
    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.dataset.target;
        tabBtns.forEach(b => b.classList.remove('active'));
        tabPanels.forEach(p => p.classList.remove('active'));
        
        btn.classList.add('active');
        document.getElementById(target).classList.add('active');
      });
    });

    // --- Tags Logic ---
    const tagInput = document.getElementById('tag-input');
    const tagsList = document.getElementById('tags-list');
    const tagsHidden = document.getElementById('tags-hidden');
    
    let tags = [];
    try { tags = JSON.parse(tagsHidden.value || '[]'); } catch(e){}

    const renderTags = () => {
      tagsList.innerHTML = '';
      tags.forEach(tag => {
        const span = document.createElement('span');
        span.className = 'tag-item';
        span.innerHTML = `${tag} <button type="button" class="remove-tag" data-tag="${tag}">&times;</button>`;
        tagsList.appendChild(span);
      });
      tagsHidden.value = JSON.stringify(tags);
    };

    tagInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        const val = tagInput.value.trim();
        if (val && !tags.includes(val)) {
          tags.push(val);
          renderTags();
          tagInput.value = '';
        }
      }
    });

    tagsList?.addEventListener('click', (e) => {
      if (e.target.classList.contains('remove-tag')) {
        const tag = e.target.dataset.tag;
        tags = tags.filter(t => t !== tag);
        renderTags();
      }
    });

    // --- Edit Info Form ---
    const editForm = document.getElementById('edit-supplier-form');
    editForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('btn-save-info');
      const originalText = btn.textContent;
      btn.textContent = 'Guardando...';
      btn.disabled = true;

      const formData = new FormData(editForm);
      const data = Object.fromEntries(formData.entries());
      data.is_active = formData.has('is_active');
      data.is_confidential = formData.has('is_confidential');
      data.tags = JSON.parse(data.tags || '[]');

      try {
        const res = await fetch(`/api/suppliers/${editForm.dataset.id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        
        if (res.ok) {
          window.showToast('Proveedor actualizado exitosamente', 'success');
          setTimeout(() => window.location.reload(), 1000);
        } else {
          window.showToast('Error al actualizar proveedor', 'error');
        }
      } catch (err) {
        window.showToast('Error de conexión', 'error');
      } finally {
        btn.textContent = originalText;
        btn.disabled = false;
      }
    });

    // --- Star Rating Selector Logic ---
    const starGroups = document.querySelectorAll('.star-selector');
    starGroups.forEach(group => {
      const stars = group.querySelectorAll('.star-btn');
      const hiddenInput = group.querySelector('input[type="hidden"]');
      
      stars.forEach(star => {
        star.addEventListener('click', () => {
          const val = parseInt(star.dataset.val);
          hiddenInput.value = val;
          // reset all
          stars.forEach(s => s.classList.remove('active'));
          // highlight up to val
          stars.forEach(s => {
            if (parseInt(s.dataset.val) <= val) s.classList.add('active');
          });
        });
      });
    });

    // --- Toggles for inline forms ---
    const toggleForm = (btnId, formContainerId, cancelBtnId) => {
      const btn = document.getElementById(btnId);
      const form = document.getElementById(formContainerId);
      const cancel = document.getElementById(cancelBtnId);
      
      btn?.addEventListener('click', () => {
        form.classList.remove('hidden');
        btn.style.display = 'none';
      });
      
      cancel?.addEventListener('click', () => {
        form.classList.add('hidden');
        btn.style.display = 'block';
        form.querySelector('form').reset();
      });
    };

    toggleForm('btn-toggle-purchase-form', 'new-purchase-form', 'btn-cancel-purchase');
    toggleForm('btn-toggle-social-form', 'new-social-form', 'btn-cancel-social');
    toggleForm('btn-toggle-doc-form', 'new-doc-form', 'btn-cancel-doc');

    // --- Add Purchase ---
    const formAddPurchase = document.getElementById('form-add-purchase');
    formAddPurchase?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = formAddPurchase.dataset.supplier;
      const formData = new FormData(formAddPurchase);
      const data = Object.fromEntries(formData.entries());
      
      // Parse numbers
      data.total_usd = parseFloat(data.total_usd);
      data.quality_rating = parseInt(data.quality_rating);
      data.punctuality_rating = parseInt(data.punctuality_rating);
      data.communication_rating = parseInt(data.communication_rating);
      data.price_rating = parseInt(data.price_rating);

      const btn = formAddPurchase.querySelector('button[type="submit"]');
      btn.disabled = true;

      try {
        const res = await fetch(`/api/suppliers/${id}/purchases`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        if (res.ok) {
          window.showToast('Compra registrada exitosamente', 'success');
          setTimeout(() => window.location.reload(), 1000);
        } else {
          window.showToast('Error al registrar compra', 'error');
          btn.disabled = false;
        }
      } catch (err) {
        window.showToast('Error de conexión', 'error');
        btn.disabled = false;
      }
    });

    // --- Delete Purchase ---
    document.querySelectorAll('.delete-purchase').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('¿Estás seguro de eliminar esta compra?')) return;
        const purchaseId = btn.dataset.id;
        const supplierId = document.getElementById('edit-supplier-form').dataset.id;
        
        try {
          const res = await fetch(`/api/suppliers/${supplierId}/purchases?purchaseId=${purchaseId}`, {
            method: 'DELETE'
          });
          if (res.ok) {
            window.showToast('Compra eliminada', 'success');
            setTimeout(() => window.location.reload(), 1000);
          } else {
            window.showToast('Error al eliminar compra', 'error');
          }
        } catch (e) {
          window.showToast('Error de conexión', 'error');
        }
      });
    });

    // --- Add Social ---
    const formAddSocial = document.getElementById('form-add-social');
    formAddSocial?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = formAddSocial.dataset.supplier;
      const formData = new FormData(formAddSocial);
      const data = Object.fromEntries(formData.entries());

      const btn = formAddSocial.querySelector('button[type="submit"]');
      btn.disabled = true;

      try {
        const res = await fetch(`/api/suppliers/${id}/socials`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        if (res.ok) {
          window.showToast('Perfil agregado exitosamente', 'success');
          setTimeout(() => window.location.reload(), 1000);
        } else {
          window.showToast('Error al agregar perfil', 'error');
          btn.disabled = false;
        }
      } catch (err) {
        window.showToast('Error de conexión', 'error');
        btn.disabled = false;
      }
    });

    // --- Delete Social ---
    document.querySelectorAll('.delete-social').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('¿Eliminar este perfil social?')) return;
        const socialId = btn.dataset.id;
        const supplierId = document.getElementById('edit-supplier-form').dataset.id;
        
        try {
          const res = await fetch(`/api/suppliers/${supplierId}/socials?socialId=${socialId}`, {
            method: 'DELETE'
          });
          if (res.ok) {
            window.showToast('Perfil eliminado', 'success');
            setTimeout(() => window.location.reload(), 1000);
          } else {
            window.showToast('Error al eliminar perfil', 'error');
          }
        } catch (e) {
          window.showToast('Error de conexión', 'error');
        }
      });
    });

    // --- Add Document ---
    const formAddDoc = document.getElementById('form-add-doc');
    formAddDoc?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = formAddDoc.dataset.supplier;
      const formData = new FormData(formAddDoc);
      const data = Object.fromEntries(formData.entries());

      const btn = formAddDoc.querySelector('button[type="submit"]');
      btn.disabled = true;

      try {
        const res = await fetch(`/api/suppliers/${id}/documents`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        if (res.ok) {
          window.showToast('Documento agregado exitosamente', 'success');
          setTimeout(() => window.location.reload(), 1000);
        } else {
          window.showToast('Error al agregar documento', 'error');
          btn.disabled = false;
        }
      } catch (err) {
        window.showToast('Error de conexión', 'error');
        btn.disabled = false;
      }
    });

    // --- Delete Document ---
    document.querySelectorAll('.delete-doc').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('¿Eliminar este documento?')) return;
        const docId = btn.dataset.id;
        const supplierId = document.getElementById('edit-supplier-form').dataset.id;
        
        try {
          const res = await fetch(`/api/suppliers/${supplierId}/documents?documentId=${docId}`, {
            method: 'DELETE'
          });
          if (res.ok) {
            window.showToast('Documento eliminado', 'success');
            setTimeout(() => window.location.reload(), 1000);
          } else {
            window.showToast('Error al eliminar documento', 'error');
          }
        } catch (e) {
          window.showToast('Error de conexión', 'error');
        }
      });
    });

  });
</script>
