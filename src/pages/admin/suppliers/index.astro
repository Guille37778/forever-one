<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('searchInput');
    const tagPills = document.querySelectorAll('.tag-pill');
    const statusRadios = document.querySelectorAll('input[name="statusFilter"]');
    const tableRows = document.querySelectorAll('.supplier-row');
    const deleteBtns = document.querySelectorAll('.delete-btn');

    let activeTag = 'all';
    let activeStatus = 'all';
    let searchQuery = '';

    function filterTable() {
      tableRows.forEach(row => {
        const name = row.getAttribute('data-name') || '';
        const contact = row.getAttribute('data-contact') || '';
        const email = row.getAttribute('data-email') || '';
        const tags = (row.getAttribute('data-tags') || '').split(',');
        const status = row.getAttribute('data-status') || '';

        const matchesSearch = name.includes(searchQuery) || contact.includes(searchQuery) || email.includes(searchQuery);
        const matchesTag = activeTag === 'all' || tags.includes(activeTag);
        const matchesStatus = activeStatus === 'all' || status === activeStatus;

        if (matchesSearch && matchesTag && matchesStatus) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    }

    searchInput.addEventListener('input', (e) => {
      searchQuery = e.target.value.toLowerCase();
      filterTable();
    });

    tagPills.forEach(pill => {
      pill.addEventListener('click', (e) => {
        tagPills.forEach(p => p.classList.remove('active'));
        e.target.classList.add('active');
        activeTag = e.target.getAttribute('data-tag');
        filterTable();
      });
    });

    statusRadios.forEach(radio => {
      radio.addEventListener('change', (e) => {
        activeStatus = e.target.value;
        filterTable();
      });
    });

    deleteBtns.forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const id = e.currentTarget.getAttribute('data-id');
        if (confirm('¿Estás seguro de que deseas eliminar este proveedor? Esta acción no se puede deshacer.')) {
          try {
            const res = await fetch(`/api/suppliers/${id}`, { method: 'DELETE' });
            if (res.ok) {
              if (window.showToast) window.showToast('Proveedor eliminado exitosamente', 'success');
              const row = document.querySelector(`.supplier-row[data-id="${id}"]`);
              if (row) row.remove();
            } else {
              throw new Error('Error al eliminar');
            }
          } catch (err) {
            if (window.showToast) window.showToast('Error al eliminar el proveedor', 'error');
            console.error(err);
          }
        }
      });
    });
  });
</script>

