<script is:inline define:vars={{ bcvRate, zelleRate }}>
  // ── Referencias DOM ──────────────────────────────
  const modal        = document.getElementById('modal-simulacion');
  const btnAbrir     = document.getElementById('btn-simulacion');
  const btnCerrar    = document.getElementById('btn-close-modal');
  const btnCalcular  = document.getElementById('btn-calcular');
  const btnGuardar   = document.getElementById('btn-guardar-sim');
  const btnComparar  = document.getElementById('btn-comparar-sim');
  const panelHistorial = document.getElementById('panel-historial');

  // Abrir / cerrar modal
  btnAbrir?.addEventListener('click', () => { modal.style.display = 'block'; });
  btnCerrar?.addEventListener('click', () => { modal.style.display = 'none'; });
  modal?.addEventListener('click', (e) => { if (e.target === modal) modal.style.display = 'none'; });

  // ── Formatters ───────────────────────────────────
  const fUSD = (v) => '$' + Number(v).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const fBs  = (v) => 'Bs. ' + Number(v).toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const fPct = (v) => Number(v).toFixed(1) + '%';

  // ── Cálculo central ──────────────────────────────
  // precio_etiqueta_BCV = (costo + ganancia) * zelleRate / bcvRate
  function calcEscenario(costo, ganancia, cantidad, zRate, bRate) {
    const totalZelle   = costo + ganancia;
    const bolivares    = totalZelle * zRate;
    const precioEtiq   = bolivares / bRate;
    const gananciaTotalLote = ganancia * cantidad;
    const margen       = (ganancia / costo) * 100;
    return { totalZelle, bolivares, precioEtiq, gananciaTotalLote, margen };
  }

  // ── Botón Calcular ───────────────────────────────
  btnCalcular?.addEventListener('click', () => {
    const costo     = parseFloat(document.getElementById('sim-costo').value)    || 0;
    const cantidad  = parseInt(document.getElementById('sim-cantidad').value)    || 1;
    const customG   = parseFloat(document.getElementById('sim-ganancia-custom').value);

    if (costo <= 0) {
      window.showToast && window.showToast('Ingresa el costo por pieza en Zelle', 'error');
      return;
    }
    if (bcvRate <= 0 || zelleRate <= 0) {
      window.showToast && window.showToast('Las tasas BCV y Zelle deben estar configuradas en el sistema', 'error');
      return;
    }

    // Niveles de ganancia fijos + personalizada
    const niveles = [3, 4, 5, 6, 10];
    if (!isNaN(customG) && customG > 0 && !niveles.includes(customG)) {
      niveles.push(customG);
      niveles.sort((a, b) => a - b);
    }

    // ── Summary cards ────────────────────────────
    const inversionTotal  = costo * cantidad;
    const puntoEquilibrio = (costo * zelleRate) / bcvRate;
    document.getElementById('sim-summary-cards').innerHTML = `
      <div style="background:#f8f8f8; border-radius:12px; padding:1rem 1.25rem;">
        <p style="font-size:8px;text-transform:uppercase;letter-spacing:.2em;color:#aaa;font-weight:700;margin-bottom:4px;">Inversión Total del Lote</p>
        <p style="font-size:1.4rem;font-family:'Playfair Display',serif;font-style:italic;color:#111;font-weight:700;">${fUSD(inversionTotal)} <span style="font-size:.75rem;color:#888;font-style:normal;">Zelle</span></p>
        <p style="font-size:10px;color:#aaa;margin-top:2px;">${cantidad} pzas × ${fUSD(costo)}</p>
      </div>
      <div style="background:#f8fff8; border:1px solid rgba(34,197,94,0.15); border-radius:12px; padding:1rem 1.25rem;">
        <p style="font-size:8px;text-transform:uppercase;letter-spacing:.2em;color:#15803d;font-weight:700;margin-bottom:4px;">Precio de Punto de Equilibrio</p>
        <p style="font-size:1.4rem;font-family:'Playfair Display',serif;font-style:italic;color:#111;font-weight:700;">${fUSD(puntoEquilibrio)} <span style="font-size:.75rem;color:#888;font-style:normal;">BCV</span></p>
        <p style="font-size:10px;color:#aaa;margin-top:2px;">Mínimo para no perder dinero</p>
      </div>
      <div style="background:#fdfaf0; border:1px solid rgba(184,134,11,0.15); border-radius:12px; padding:1rem 1.25rem;">
        <p style="font-size:8px;text-transform:uppercase;letter-spacing:.2em;color:#B8860B;font-weight:700;margin-bottom:4px;">Tasas Aplicadas</p>
        <p style="font-size:11px;color:#555;margin-top:4px;">Zelle: <strong>Bs. ${zelleRate.toFixed(2)}</strong></p>
        <p style="font-size:11px;color:#555;">BCV: <strong>Bs. ${bcvRate.toFixed(2)}</strong></p>
      </div>
    `;

    // ── Tabla de escenarios ───────────────────────
    const colores = ['#f0fdf4','#f0f9ff','#fefce8','#fdf4ff','#fff1f2','#f8fafc'];
    let html = '';
    niveles.forEach((g, i) => {
      const r = calcEscenario(costo, g, cantidad, zelleRate, bcvRate);
      const isCustom = !isNaN(customG) && g === customG && ![3,4,5,6,10].includes(customG);
      const badge = isCustom ? ' <span style="font-size:7px;background:#6e3cb4;color:white;padding:1px 6px;border-radius:4px;letter-spacing:.05em;">CUSTOM</span>' : '';
      html += `
        <tr style="background:${colores[i % colores.length]}; transition:background .2s;" onmouseover="this.style.background='#fdfaf0'" onmouseout="this.style.background='${colores[i % colores.length]}'">
          <td style="padding:1rem 1.25rem; font-size:13px; font-weight:700; color:#111;">
            ${fUSD(g)} Zelle${badge}
          </td>
          <td style="padding:1rem 1.25rem;">
            <span style="font-size:1.1rem; font-family:'Playfair Display',serif; font-style:italic; font-weight:700; color:#0a0a0a;">${fUSD(r.precioEtiq)}</span>
            <span style="font-size:9px; color:#aaa; margin-left:4px;">BCV</span>
          </td>
          <td style="padding:1rem 1.25rem; font-size:12px; color:#555;">${fBs(r.bolivares)}</td>
          <td style="padding:1rem 1.25rem;">
            <span style="font-size:13px; font-weight:700; color:#15803d;">${fUSD(r.gananciaTotalLote)}</span>
            <span style="font-size:9px; color:#aaa; display:block;">Zelle</span>
          </td>
          <td style="padding:1rem 1.25rem;">
            <span style="display:inline-block; padding:3px 10px; border-radius:20px; font-size:9px; font-weight:800; background:rgba(34,197,94,0.1); color:#15803d;">${fPct(r.margen)}</span>
          </td>
        </tr>`;
    });
    document.getElementById('sim-tabla-body').innerHTML = html;

    // ── Sensibilidad ─────────────────────────────
    const zelleAlt = parseFloat(document.getElementById('sim-zelle-alt').value);
    const bcvAlt   = parseFloat(document.getElementById('sim-bcv-alt').value);
    actualizarSensibilidad(costo, 5, cantidad, zelleAlt, bcvAlt);

    document.getElementById('sim-resultados').style.display = 'block';
    document.getElementById('sim-resultados').scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  // ── Sensibilidad en tiempo real ───────────────
  ['sim-zelle-alt', 'sim-bcv-alt'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', () => {
      const costo    = parseFloat(document.getElementById('sim-costo').value) || 0;
      const cantidad = parseInt(document.getElementById('sim-cantidad').value) || 1;
      const zA = parseFloat(document.getElementById('sim-zelle-alt').value);
      const bA = parseFloat(document.getElementById('sim-bcv-alt').value);
      if (costo > 0) actualizarSensibilidad(costo, 5, cantidad, zA, bA);
    });
  });

  function actualizarSensibilidad(costo, ganancia, cantidad, zelleAlt, bcvAlt) {
    const div = document.getElementById('sim-sensibilidad-resultado');
    if (!div) return;
    let html = `<p style="font-size:10px;color:#888;margin-bottom:8px;">Basado en ganancia de ${fUSD(ganancia)} Zelle por pieza:</p>`;

    const base = calcEscenario(costo, ganancia, cantidad, zelleRate, bcvRate);
    html += `<span style="display:inline-block;background:#f0f0f0;border-radius:6px;padding:4px 10px;font-size:11px;font-weight:700;margin-right:8px;">Actual: ${fUSD(base.precioEtiq)} BCV</span>`;

    if (!isNaN(zelleAlt) && zelleAlt > 0) {
      const r = calcEscenario(costo, ganancia, cantidad, zelleAlt, bcvRate);
      const diff = r.precioEtiq - base.precioEtiq;
      const sign = diff >= 0 ? '+' : '';
      html += `<span style="display:inline-block;background:#fff8e7;border:1px solid rgba(184,134,11,0.2);border-radius:6px;padding:4px 10px;font-size:11px;font-weight:700;margin-right:8px;">Zelle ${zelleAlt}: ${fUSD(r.precioEtiq)} BCV <span style="color:${diff>=0?'#15803d':'#b91c1c'};">(${sign}${fUSD(diff)})</span></span>`;
    }
    if (!isNaN(bcvAlt) && bcvAlt > 0) {
      const r = calcEscenario(costo, ganancia, cantidad, zelleRate, bcvAlt);
      const diff = r.precioEtiq - base.precioEtiq;
      const sign = diff >= 0 ? '+' : '';
      html += `<span style="display:inline-block;background:#f5f0ff;border:1px solid rgba(110,60,180,0.2);border-radius:6px;padding:4px 10px;font-size:11px;font-weight:700;">BCV ${bcvAlt}: ${fUSD(r.precioEtiq)} BCV <span style="color:${diff>=0?'#15803d':'#b91c1c'};">(${sign}${fUSD(diff)})</span></span>`;
    }
    if ((isNaN(zelleAlt) || zelleAlt <= 0) && (isNaN(bcvAlt) || bcvAlt <= 0)) {
      html += `<span style="font-size:11px;color:#bbb;">Ingresa tasas alternativas arriba para ver el impacto en precios.</span>`;
    }
    div.innerHTML = html;
  }

  // ── Guardar simulación en localStorage ───────
  btnGuardar?.addEventListener('click', () => {
    const costo    = parseFloat(document.getElementById('sim-costo').value)    || 0;
    const cantidad = parseInt(document.getElementById('sim-cantidad').value)    || 1;
    const nombre   = document.getElementById('sim-producto').value || 'Sin nombre';
    if (costo <= 0) { window.showToast && window.showToast('Primero calcula una simulación', 'error'); return; }

    const sims = JSON.parse(localStorage.getItem('fo_simulaciones') || '[]');
    sims.unshift({
      id: Date.now(),
      nombre,
      costo,
      cantidad,
      zelleRate,
      bcvRate,
      fecha: new Date().toLocaleDateString('es-VE', { day:'2-digit', month:'short', year:'numeric' })
    });
    if (sims.length > 20) sims.length = 20; // max 20
    localStorage.setItem('fo_simulaciones', JSON.stringify(sims));
    window.showToast && window.showToast('Simulación guardada correctamente');
    renderHistorial();
    panelHistorial.style.display = 'block';
  });

  // ── Ver historial ─────────────────────────────
  btnComparar?.addEventListener('click', () => {
    renderHistorial();
    panelHistorial.style.display = panelHistorial.style.display === 'none' ? 'block' : 'none';
  });

  function renderHistorial() {
    const sims = JSON.parse(localStorage.getItem('fo_simulaciones') || '[]');
    const lista = document.getElementById('historial-lista');
    if (!sims.length) {
      lista.innerHTML = '<p style="font-size:11px;color:#bbb;text-align:center;padding:1rem;">Aún no hay simulaciones guardadas.</p>';
      return;
    }
    lista.innerHTML = sims.map(s => {
      const precioBcv5 = calcEscenario(s.costo, 5, s.cantidad, s.zelleRate, s.bcvRate).precioEtiq;
      return `
        <div style="display:flex;align-items:center;justify-content:space-between;padding:.75rem 0;border-bottom:1px solid #f5f5f5;gap:1rem;flex-wrap:wrap;">
          <div>
            <p style="font-size:12px;font-weight:700;color:#111;">${s.nombre}</p>
            <p style="font-size:10px;color:#aaa;">${s.fecha} · ${s.cantidad} pzas · Costo ${fUSD(s.costo)} Zelle</p>
          </div>
          <div style="text-align:right;">
            <p style="font-size:10px;color:#888;">Precio con $5 ganancia:</p>
            <p style="font-size:13px;font-weight:700;color:#B8860B;">${fUSD(precioBcv5)} BCV</p>
          </div>
          <button onclick="cargarSimulacion(${s.id})" style="padding:6px 14px;background:#f8f8f8;border:1px solid #eee;border-radius:8px;font-size:9px;text-transform:uppercase;letter-spacing:.15em;font-weight:700;cursor:pointer;color:#555;">Cargar</button>
        </div>`;
    }).join('');
  }

  // ── Cargar simulación guardada ────────────────
  window.cargarSimulacion = function(id) {
    const sims = JSON.parse(localStorage.getItem('fo_simulaciones') || '[]');
    const s = sims.find(x => x.id === id);
    if (!s) return;
    document.getElementById('sim-producto').value  = s.nombre;
    document.getElementById('sim-costo').value     = s.costo;
    document.getElementById('sim-cantidad').value  = s.cantidad;
    panelHistorial.style.display = 'none';
    btnCalcular.click();
    window.showToast && window.showToast('Simulación cargada');
  };
</script>
