---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabase, supabaseAdmin } from '../../lib/supabase';

const accessToken = Astro.cookies.get('sb-access-token')?.value;
if (!accessToken) return Astro.redirect('/admin/login');

let user = null;
try {
  const { data: userData, error: authError } = await supabase.auth.getUser(accessToken);
  if (authError || !userData?.user) return Astro.redirect('/admin/login');
  user = userData.user;
} catch (e) {
  return Astro.redirect('/admin/login');
}

// Filtro de período desde query param
const period = Astro.url.searchParams.get('period') || 'month';

const now = new Date();
let fromDate: string;
if (period === 'today') {
  fromDate = new Date(now.getFullYear(), now.getMonth(), now.getDate()).toISOString();
} else if (period === 'week') {
  const d = new Date(now); d.setDate(d.getDate() - 7);
  fromDate = d.toISOString();
} else if (period === 'month') {
  fromDate = new Date(now.getFullYear(), now.getMonth(), 1).toISOString();
} else {
  fromDate = '2000-01-01T00:00:00Z'; // Todo el tiempo
}

// Obtener todas las ventas cerradas (paid_at NOT NULL)
const { data: salesRaw } = await supabaseAdmin
  .from('orders')
  .select('*, order_items(*)')
  .eq('status', 'entregado')
  .not('paid_at', 'is', null)
  .gte('paid_at', fromDate)
  .order('paid_at', { ascending: false });

const sales: any[] = salesRaw || [];

// KPIs
const totalRevenue = sales.reduce((acc, s) => acc + parseFloat(s.total_usd || 0), 0);
const totalCount   = sales.length;
const avgTicket    = totalCount > 0 ? totalRevenue / totalCount : 0;

// Top productos vendidos
const productMap: Record<string, { name: string; qty: number; revenue: number }> = {};
for (const sale of sales) {
  for (const item of (sale.order_items || [])) {
    const key = item.product_id;
    if (!productMap[key]) productMap[key] = { name: item.product_name, qty: 0, revenue: 0 };
    productMap[key].qty     += item.quantity || 1;
    productMap[key].revenue += parseFloat(item.price_usd || 0) * (item.quantity || 1);
  }
}
const topProducts = Object.values(productMap)
  .sort((a, b) => b.revenue - a.revenue)
  .slice(0, 5);

// Datos para gráfico diario (últimos 30 días, independiente del filtro)
const thirtyDaysAgo = new Date(); thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);
const { data: chartRaw } = await supabaseAdmin
  .from('orders')
  .select('paid_at, total_usd')
  .eq('status', 'entregado')
  .not('paid_at', 'is', null)
  .gte('paid_at', thirtyDaysAgo.toISOString());

// Agrupar por día
const dailyMap: Record<string, number> = {};
for (const r of (chartRaw || [])) {
  const day = r.paid_at.slice(0, 10);
  dailyMap[day] = (dailyMap[day] || 0) + parseFloat(r.total_usd || 0);
}
// Rellenar los últimos 30 días (para que el gráfico no tenga huecos)
const chartLabels: string[] = [];
const chartValues: number[] = [];
for (let i = 29; i >= 0; i--) {
  const d = new Date(); d.setDate(d.getDate() - i);
  const key = d.toISOString().slice(0, 10);
  chartLabels.push(key.slice(5)); // MM-DD
  chartValues.push(dailyMap[key] || 0);
}

const periodLabels: Record<string, string> = {
  today: 'Hoy',
  week:  'Esta Semana',
  month: 'Este Mes',
  all:   'Todo el Tiempo',
};
---

<AdminLayout title="Módulo de Ventas" activeNav="ventas" user={{ email: user?.email || '' }}>

<style>
  /* ─── Header ──────────────────────────────────────── */
  .page-header { margin-bottom: 2rem; }
  .page-header p  { font-size: 9px; letter-spacing: 0.35em; text-transform: uppercase; color: #B8860B; font-weight: 700; margin-bottom: 4px; }
  .page-header h2 { font-family: 'Playfair Display', serif; font-size: 1.75rem; font-weight: 900; font-style: italic; color: #111; }

  /* ─── Filtros ─────────────────────────────────────── */
  .period-filter { display: flex; gap: 0.5rem; margin-bottom: 2rem; flex-wrap: wrap; }
  .period-btn {
    font-size: 8px; letter-spacing: 0.2em; text-transform: uppercase; font-weight: 700;
    padding: 0.6rem 1.25rem; border-radius: 8px; border: 1px solid #e8e8e8;
    background: white; color: #888; text-decoration: none; transition: all 0.2s;
  }
  .period-btn:hover { border-color: #B8860B; color: #B8860B; }
  .period-btn.active { background: #111; color: #f3cf7a; border-color: #111; }

  /* ─── KPIs ────────────────────────────────────────── */
  .kpi-grid {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-bottom: 2rem;
  }
  @media (min-width: 1024px) { .kpi-grid { grid-template-columns: repeat(4, 1fr); } }

  .kpi-card {
    background: white; border: 1px solid rgba(184,134,11,0.08); border-radius: 16px;
    padding: 1.5rem; box-shadow: 0 4px 15px rgba(0,0,0,0.03);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .kpi-card:hover { transform: translateY(-4px); box-shadow: 0 12px 25px rgba(0,0,0,0.06); border-color: rgba(184,134,11,0.2); }
  .kpi-card.gold { background: linear-gradient(135deg, #0a0a0a, #1a1205); border-color: rgba(184,134,11,0.3); }

  .kpi-icon { width: 40px; height: 40px; border-radius: 12px; background: #fafafa; border: 1px solid #f0f0f0; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem; color: #B8860B; }
  .kpi-icon svg { width: 20px; height: 20px; }
  .kpi-card.gold .kpi-icon { background: rgba(184,134,11,0.12); border-color: rgba(184,134,11,0.2); }

  .kpi-label { font-size: 8px; letter-spacing: 0.2em; text-transform: uppercase; color: #999; font-weight: 700; margin-bottom: 4px; }
  .kpi-card.gold .kpi-label { color: rgba(184,134,11,0.6); }

  .kpi-value { font-family: 'Playfair Display', serif; font-size: 2rem; font-weight: 900; font-style: italic; color: #111; line-height: 1; }
  .kpi-card.gold .kpi-value { color: #f3cf7a; font-size: 2.25rem; }

  .kpi-sub { font-size: 9px; color: #B8860B; font-weight: 600; margin-top: 6px; opacity: 0.7; }
  .kpi-card.gold .kpi-sub { color: rgba(255,255,255,0.35); }

  /* ─── Chart ───────────────────────────────────────── */
  .chart-card {
    background: white; border: 1px solid rgba(0,0,0,0.05); border-radius: 16px;
    padding: 1.75rem; margin-bottom: 2rem; box-shadow: 0 4px 15px rgba(0,0,0,0.03);
  }
  .chart-header { margin-bottom: 1.5rem; }
  .chart-title { font-size: 8px; letter-spacing: 0.3em; text-transform: uppercase; color: #bbb; font-weight: 700; margin-bottom: 4px; }
  .chart-subtitle { font-family: 'Playfair Display', serif; font-size: 1.1rem; font-weight: 700; font-style: italic; color: #111; }
  canvas { width: 100% !important; }

  /* ─── Bottom Grid ─────────────────────────────────── */
  .bottom-grid { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 900px) { .bottom-grid { grid-template-columns: 1fr 1.6fr; } }

  /* ─── Top Productos ───────────────────────────────── */
  .card { background: white; border: 1px solid rgba(0,0,0,0.05); border-radius: 16px; padding: 1.5rem; box-shadow: 0 4px 15px rgba(0,0,0,0.03); }
  .card-title { font-size: 8px; letter-spacing: 0.3em; text-transform: uppercase; color: #bbb; font-weight: 700; margin-bottom: 1.25rem; }

  .product-rank { display: flex; align-items: center; gap: 1rem; padding: 0.85rem 0; border-bottom: 1px solid #f5f5f5; }
  .product-rank:last-child { border-bottom: none; }
  .rank-num { font-family: 'Playfair Display', serif; font-size: 1.5rem; font-weight: 900; font-style: italic; color: #e8e8e8; min-width: 32px; line-height: 1; }
  .rank-info { flex: 1; }
  .rank-name { font-size: 11px; font-weight: 700; color: #111; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 2px; }
  .rank-qty { font-size: 9px; color: #aaa; font-weight: 600; }
  .rank-revenue { font-family: 'Playfair Display', serif; font-size: 1rem; font-weight: 900; font-style: italic; color: #B8860B; }

  /* ─── Tabla de Ventas ─────────────────────────────── */
  .sales-table { width: 100%; border-collapse: collapse; }
  .sales-table th { font-size: 7.5px; letter-spacing: 0.25em; text-transform: uppercase; color: #bbb; font-weight: 700; padding: 0 0 1rem 0; text-align: left; border-bottom: 1px solid #f0f0f0; }
  .sales-table td { font-size: 11px; color: #444; padding: 0.85rem 0; border-bottom: 1px solid rgba(0,0,0,0.03); vertical-align: middle; }
  .sales-table tr:last-child td { border-bottom: none; }

  .order-code-cell { font-family: 'Playfair Display', serif; font-weight: 900; font-style: italic; color: #B8860B; font-size: 13px; }
  .total-cell { font-family: 'Playfair Display', serif; font-weight: 900; font-style: italic; color: #111; font-size: 14px; }
  .date-cell { font-size: 9px; color: #bbb; font-weight: 600; }

  .paid-badge { display: inline-flex; align-items: center; gap: 4px; background: rgba(34,197,94,0.1); color: #15803d; border: 1px solid rgba(34,197,94,0.25); border-radius: 6px; font-size: 7px; font-weight: 800; letter-spacing: 0.15em; text-transform: uppercase; padding: 3px 10px; }

  .empty-state { text-align: center; padding: 4rem 2rem; }
  .empty-icon { font-size: 3rem; margin-bottom: 1rem; opacity: 0.2; }
  .empty-text { font-size: 9px; letter-spacing: 0.4em; text-transform: uppercase; color: #ccc; font-weight: 700; }

  @media (max-width: 768px) {
    .kpi-value { font-size: 1.5rem; }
    .kpi-card.gold .kpi-value { font-size: 1.75rem; }
    .sales-table th:nth-child(3), .sales-table td:nth-child(3) { display: none; }
  }
</style>

<!-- Header -->
<div class="page-header">
  <p>Módulo Comercial</p>
  <h2>Central de Ventas</h2>
</div>

<!-- Filtros de período -->
<nav class="period-filter" aria-label="Filtro de período">
  {['today', 'week', 'month', 'all'].map(p => (
    <a
      href={`/admin/ventas?period=${p}`}
      class={`period-btn ${period === p ? 'active' : ''}`}
      id={`filter-${p}`}
    >
      {periodLabels[p]}
    </a>
  ))}
</nav>

<!-- KPIs -->
<div class="kpi-grid">
  <!-- Ingresos -->
  <div class="kpi-card gold">
    <div class="kpi-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>
      </svg>
    </div>
    <p class="kpi-label">Ingresos — {periodLabels[period]}</p>
    <p class="kpi-value">${totalRevenue.toFixed(2)}</p>
    <p class="kpi-sub">En dólares (USD)</p>
  </div>

  <!-- Ventas cerradas -->
  <div class="kpi-card">
    <div class="kpi-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
      </svg>
    </div>
    <p class="kpi-label">Ventas Cerradas</p>
    <p class="kpi-value">{totalCount}</p>
    <p class="kpi-sub">Pedidos confirmados</p>
  </div>

  <!-- Ticket promedio -->
  <div class="kpi-card">
    <div class="kpi-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/>
      </svg>
    </div>
    <p class="kpi-label">Ticket Promedio</p>
    <p class="kpi-value">${avgTicket.toFixed(2)}</p>
    <p class="kpi-sub">Por venta</p>
  </div>

  <!-- Mejor producto -->
  <div class="kpi-card">
    <div class="kpi-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
      </svg>
    </div>
    <p class="kpi-label">Top Prenda</p>
    <p class="kpi-value" style="font-size:1rem; line-height:1.3;">
      {topProducts[0]?.name || '—'}
    </p>
    <p class="kpi-sub">{topProducts[0] ? `$${topProducts[0].revenue.toFixed(2)} generados` : 'Sin ventas aún'}</p>
  </div>
</div>

<!-- Gráfico de barras — últimos 30 días -->
<div class="chart-card">
  <div class="chart-header">
    <p class="chart-title">Tendencia de Ingresos</p>
    <p class="chart-subtitle">Últimos 30 días</p>
  </div>
  <canvas id="sales-chart" height="80"></canvas>
</div>

<!-- Bottom: Top productos + Tabla de ventas -->
<div class="bottom-grid">

  <!-- Top Productos -->
  <div class="card">
    <p class="card-title">✦ Prendas Más Vendidas</p>
    {topProducts.length > 0 ? topProducts.map((p, i) => (
      <div class="product-rank">
        <span class="rank-num">0{i + 1}</span>
        <div class="rank-info">
          <p class="rank-name">{p.name}</p>
          <p class="rank-qty">{p.qty} unidades vendidas</p>
        </div>
        <span class="rank-revenue">${p.revenue.toFixed(2)}</span>
      </div>
    )) : (
      <div class="empty-state">
        <div class="empty-icon">📦</div>
        <p class="empty-text">Sin ventas en este período</p>
      </div>
    )}
  </div>

  <!-- Tabla historial de ventas -->
  <div class="card">
    <p class="card-title">✦ Historial de Ventas Confirmadas</p>
    {sales.length > 0 ? (
      <div style="overflow-x: auto;">
        <table class="sales-table">
          <thead>
            <tr>
              <th>Código</th>
              <th>Cliente</th>
              <th>Prendas</th>
              <th>Total</th>
              <th>Fecha</th>
            </tr>
          </thead>
          <tbody>
            {sales.map(sale => (
              <tr>
                <td class="order-code-cell">{sale.order_code}</td>
                <td>
                  <div style="font-size:11px; font-weight:700; color:#111;">{sale.customer_name}</div>
                  <div style="font-size:9px; color:#bbb;">{sale.customer_phone}</div>
                </td>
                <td>
                  <div style="font-size:10px; color:#666;">
                    {sale.order_items?.length || 0} prenda{(sale.order_items?.length || 0) !== 1 ? 's' : ''}
                  </div>
                </td>
                <td class="total-cell">${parseFloat(sale.total_usd).toFixed(2)}</td>
                <td class="date-cell">
                  {new Date(sale.paid_at).toLocaleDateString('es-VE', { day:'2-digit', month:'short', year:'numeric' })}
                  <br/>
                  <span class="paid-badge">✓ Pagado</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <div class="empty-state">
        <div class="empty-icon">💰</div>
        <p class="empty-text">No hay ventas en este período</p>
      </div>
    )}
  </div>

</div>

</AdminLayout>

<script define:vars={{ chartLabels, chartValues }}>
  // Gráfico de barras nativo con Canvas API
  const canvas = document.getElementById('sales-chart');
  if (!canvas) return;

  const ctx = canvas.getContext('2d');
  const dpr = window.devicePixelRatio || 1;
  const W = canvas.parentElement.clientWidth - 56;
  const H = 160;
  canvas.width  = W * dpr;
  canvas.height = H * dpr;
  canvas.style.width  = W + 'px';
  canvas.style.height = H + 'px';
  ctx.scale(dpr, dpr);

  const maxVal = Math.max(...chartValues, 1);
  const barCount = chartLabels.length;
  const gap = 3;
  const barW = (W - gap * (barCount - 1)) / barCount;
  const goldColor    = '#B8860B';
  const goldFade     = 'rgba(184,134,11,0.12)';
  const goldGradTop  = 'rgba(184,134,11,0.85)';
  const goldGradBot  = 'rgba(184,134,11,0.2)';

  // Draw
  chartValues.forEach((val, i) => {
    const barH = ((val / maxVal) * (H - 24)) || 2;
    const x = i * (barW + gap);
    const y = H - barH - 20;

    // Gradient bar
    const grad = ctx.createLinearGradient(0, y, 0, H - 20);
    grad.addColorStop(0, val > 0 ? goldGradTop : goldFade);
    grad.addColorStop(1, val > 0 ? goldGradBot : goldFade);

    ctx.fillStyle = grad;
    ctx.beginPath();
    ctx.roundRect(x, y, barW, barH, [3, 3, 0, 0]);
    ctx.fill();
  });

  // Labels (every 5th)
  ctx.fillStyle = '#bbb';
  ctx.font = `600 8px Montserrat, sans-serif`;
  ctx.textAlign = 'center';
  chartLabels.forEach((label, i) => {
    if (i % 5 === 0) {
      const x = i * (barW + gap) + barW / 2;
      ctx.fillText(label, x, H - 5);
    }
  });

  // Línea base
  ctx.strokeStyle = '#f0f0f0';
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.moveTo(0, H - 20);
  ctx.lineTo(W, H - 20);
  ctx.stroke();
</script>
